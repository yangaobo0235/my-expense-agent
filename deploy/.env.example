# 数据库
EXPENSE_DATASOURCE_URL=jdbc:postgresql://localhost:5432/my_expense_agent
EXPENSE_DATASOURCE_USERNAME=postgres
EXPENSE_DATASOURCE_PASSWORD=change-me

# 对象存储
EXPENSE_MINIO_ENDPOINT=http://localhost:9000
EXPENSE_MINIO_ACCESS_KEY=change-me
EXPENSE_MINIO_SECRET_KEY=change-me
EXPENSE_MINIO_BUCKET=my-expense-agent-documents

# 身份认证与内部服务
EXPENSE_BOOTSTRAP_ADMIN_USERNAME=admin
EXPENSE_BOOTSTRAP_ADMIN_PASSWORD=
EXPENSE_BOOTSTRAP_ADMIN_DISPLAY_NAME=\u7cfb\u7edf\u7ba1\u7406\u5458
EXPENSE_DEMO_USERS_ENABLED=false
EXPENSE_SESSION_COOKIE_SECURE=false
EXPENSE_MCP_SERVICE_TOKEN=replace-with-a-random-token-at-least-32-characters
EXPENSE_ACCOUNT_MCP_URL=http://localhost:25102/mcp
EXPENSE_EXPENSE_MCP_URL=http://localhost:25103/mcp
EXPENSE_AUDIT_HISTORY_MCP_URL=http://localhost:25104/mcp
EXPENSE_MCP_CONNECTION_TIMEOUT=30s
EXPENSE_MCP_TOOL_TIMEOUT=30s
EXPENSE_ALLOWED_ORIGINS=http://localhost:25105,http://127.0.0.1:25105

# 向量检索
EXPENSE_AI_EMBEDDING_PROVIDER=deterministic
EXPENSE_AI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EXPENSE_AI_EMBEDDING_API_KEY=change-me
EXPENSE_AI_EMBEDDING_MODEL=text-embedding-v4
EXPENSE_AI_EMBEDDING_DIMENSIONS=1024

# 票据视觉抽取
EXPENSE_EXTRACTION_MODE=deterministic
EXPENSE_EXTRACTION_BASE_URL=https://api.openai.com/v1
EXPENSE_EXTRACTION_API_KEY=change-me
EXPENSE_EXTRACTION_MODEL_NAME=gpt-5.4
